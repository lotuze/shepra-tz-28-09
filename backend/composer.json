{
  "name": "app/product-import-backend",
  "description": "Product import API",
  "license": "proprietary",
  "type": "project",
  "require": {
    "php": "^8.3",
    "doctrine/data-fixtures": "^2.0",
    "doctrine/migrations": "^3.0",
    "doctrine/orm": "^3.0",
    "firebase/php-jwt": "^7.2",
    "monolog/monolog": "^3.0",
    "php-di/php-di": "^7.0",
    "phpoffice/phpspreadsheet": "^2.0",
    "slim/psr7": "^1.7",
    "slim/slim": "^4.15",
    "symfony/amqp-messenger": "^7.0",
    "symfony/cache": "^7.0",
    "symfony/console": "^7.0",
    "symfony/event-dispatcher": "^7.0",
    "symfony/http-client": "^7.0",
    "symfony/messenger": "^7.0",
    "vlucas/phpdotenv": "^5.6"
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^3.0",
    "phpstan/phpstan": "^2.1",
    "phpstan/phpstan-doctrine": "^2.0",
    "phpunit/phpunit": "^11.0"
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "App\\Tests\\": "tests/"
    }
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {}
  },
  "scripts": {
    "test": "phpunit",
    "phpstan": "phpstan analyse --no-progress --memory-limit=512M",
    "cs-check": "php-cs-fixer fix --dry-run --diff --show-progress=none",
    "cs-fix": "php-cs-fixer fix --show-progress=none"
  }
}
